@model IEnumerable<TheGioiDiDong.Models.DonHang>
@{
    ViewBag.Title = "Tổng quan cửa hàng";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container-fluid mt-2 mb-5">
    <h2 class="fw-bold mb-4">📊 Bảng Điều Khiển Admin & Thống Kê</h2>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            🎉 @TempData["Message"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card text-white bg-primary shadow-sm rounded-3 mb-3">
                <div class="card-body">
                    <h5 class="card-title">Tổng Doanh Thu (Đã Hoàn Tất)</h5>
                    <h3 class="fw-bold">@String.Format("{0:0,0}", ViewBag.TongDoanhThu) đ</h3>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-white bg-success shadow-sm rounded-3 mb-3">
                <div class="card-body">
                    <h5 class="card-title">Đơn Hàng Hệ Thống</h5>
                    <h3 class="fw-bold">@ViewBag.TongSoDonHang Đơn</h3>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-white bg-warning text-dark shadow-sm rounded-3 mb-3">
                <div class="card-body">
                    <h5 class="card-title">Sản Phẩm Trên Kệ</h5>
                    <h3 class="fw-bold">@ViewBag.TongSoSanPham Sản phẩm</h3>
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-lg-4 mb-4 mb-lg-0">
            <div class="card shadow-sm border-0 rounded-3 h-100">
                <div class="card-header bg-dark text-white fw-bold">
                    📈 Trạng Thái Đơn Hàng
                </div>
                <div class="card-body d-flex align-items-center justify-content-center bg-white p-3" style="height: 350px;">
                    <div style="width: 100%; max-width: 250px;">
                        <canvas id="statusChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card shadow-sm border-0 rounded-3 h-100">
                <div class="card-header bg-success text-white fw-bold">
                    💰 Biểu Đồ Doanh Thu Theo Ngày (Đơn Hoàn Tất)
                </div>
                <div class="card-body bg-white p-3" style="height: 350px;">
                    <canvas id="revenueChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-header bg-dark text-white fw-bold">
                    🛒 Danh Sách Tất Cả Đơn Hàng
                </div>
                <div class="card-body p-0 bg-white">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Mã Đơn</th>
                                    <th>Thời Gian</th>
                                    <th>Tổng Tiền</th>
                                    <th>Trạng Thái</th>
                                    <th class="text-center">Hành Động</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td><span class="badge bg-secondary">#@item.MaDonHang</span></td>
                                        <td class="small">@(item.NgayDat.HasValue ? item.NgayDat.Value.ToString("dd/MM/yyyy HH:mm") : "")</td>
                                        <td class="text-danger fw-bold">@String.Format("{0:0,0}", item.TongTien) đ</td>
                                        <td>
                                            @if (item.MaTrangThai == 1)
                                            {<span class="badge bg-warning text-dark">Chờ xác nhận</span> }
                                            else if (item.MaTrangThai == 4)
                                            { <span class="badge bg-success">Hoàn tất</span> }
                                            else
                                            { <span class="badge bg-info">@item.TrangThaiDonHang.TenTrangThai</span>}
                                        </td>
                                        <td class="text-center">
                                            @if (item.MaTrangThai == 1)
                                            {
                                                <a href="@Url.Action("CompleteOrder", "AdminHome")?id=@item.MaDonHang"
                                                   class="btn btn-sm btn-success fw-bold py-1 px-2"
                                                   onclick="return confirm('Xác nhận hoàn tất đơn hàng này và tính vào doanh thu?');">
                                                    ✔️ Duyệt Đơn
                                                </a>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">✔️ Đã xử lý</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/Content\bootstrap\js\chart.min.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // 1. VẼ BIỂU ĐỒ TRÒN (TRẠNG THÁI)
            var ctxStatus = document.getElementById('statusChart').getContext('2d');
            new Chart(ctxStatus, {
                type: 'doughnut',
                data: {
                    labels: [@Html.Raw(ViewBag.ChartLabels)],
                    datasets: [{
                        data: [@ViewBag.ChartData],
                        backgroundColor: ['#ffc107', '#198754', '#0dcaf0', '#dc3545', '#0d6efd'],
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { position: 'bottom' } }
                }
            });

            // 2. VẼ BIỂU ĐỒ CỘT (DOANH THU THEO NGÀY)
            var ctxRevenue = document.getElementById('revenueChart').getContext('2d');
            new Chart(ctxRevenue, {
                type: 'bar', // Biểu đồ dạng cột
                data: {
                    labels: [@Html.Raw(ViewBag.RevenueLabels)],
                    datasets: [{
                        label: 'Doanh Thu (VNĐ)',
                        data: [@ViewBag.RevenueData],
                        backgroundColor: '#198754', // Màu xanh lá cây mướt mắt
                        borderRadius: 6 // Bo tròn đỉnh cột
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                callback: function(value, index, values) {
                                    return value.toLocaleString() + ' đ'; // Thêm chữ 'đ' vào trục Y
                                }
                            }
                        }
                    },
                    plugins: { legend: { display: false } } // Ẩn chú thích vì chỉ có 1 cột
                }
            });
        });
    </script>
}