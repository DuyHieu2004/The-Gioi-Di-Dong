@model IEnumerable<TheGioiDiDong.Models.NguoiDung>
@{
    ViewBag.Title = "Quản lý thành viên";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container mt-2 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">👥 Quản Lý Tài Khoản Thành Viên</h2>
        <a href="@Url.Action("Create", "AdminAccount")" class="btn btn-success fw-bold shadow-sm">
            ➕ Cấp Tài Khoản Mới
        </a>
    </div>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">@TempData["Message"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">⚠️ @TempData["Error"]</div>
    }

    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle mb-0">
                    <thead class="table-dark text-center">
                        <tr>
                            <th>ID</th>
                            <th>Tên Đăng Nhập</th>
                            <th>Họ Và Tên</th>
                            <th>Số Điện Thoại</th>
                            <th>Quyền Hạn</th>
                            <th>Trạng Thái</th>
                            <th>Hành Động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="text-center"><span class="badge bg-secondary">#@item.MaNguoiDung</span></td>
                                <td><strong class="text-dark">@item.TenDangNhap</strong></td>
                                <td>@item.HoTen</td>
                                <td class="text-center">@item.DienThoai</td>
                                <td class="text-center">
                                    <span class="badge @(item.QuyenHan == "Admin" ? "bg-danger" : "bg-info text-dark")">
                                        @item.QuyenHan
                                    </span>
                                </td>
                                <td class="text-center">
                                    @if (item.IsLocked == true)
                                    {
                                        <span class="badge bg-danger">🚫 Đang bị khóa</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">🟢 Hoạt động</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <a href="@Url.Action("Details", "AdminAccount", new { id = item.MaNguoiDung })" class="btn btn-sm btn-outline-secondary">📄 Xem</a>

                                    @if (item.IsLocked == true)
                                    {
                                        <a href="@Url.Action("ToggleLock", "AdminAccount", new { id = item.MaNguoiDung })" class="btn btn-sm btn-success">🔓 Mở khóa</a>
                                    }
                                    else
                                    {
                                        <a href="@Url.Action("ToggleLock", "AdminAccount", new { id = item.MaNguoiDung })" class="btn btn-sm btn-warning text-dark" onclick="return confirm('Bạn chắc chắn muốn khóa tài khoản này? Người này sẽ không thể đăng nhập hệ thống.');">🔒 Khóa</a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>