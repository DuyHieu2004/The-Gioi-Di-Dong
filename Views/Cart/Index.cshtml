@model IEnumerable<TheGioiDiDong.Controllers.CartController.CartItem>
@{
    ViewBag.Title = "Giỏ hàng của bạn";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2 class="mt-4 mb-4">Giỏ hàng của bạn</h2>

@if (TempData["Message"] != null)
{
    <div class="alert alert-warning">@TempData["Message"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info">Giỏ hàng của bạn đang trống. <a href="@Url.Action("Index", "Product")">Tiếp tục mua sắm</a></div>
}
else
{
    <table class="table table-bordered table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>Sản phẩm</th>
                <th>Đơn giá</th>
                <th style="width: 150px;">Số lượng</th>
                <th>Thành tiền</th>
                <th>Hành động</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.SanPham.TenSanPham</td>
                    <td class="text-danger fw-bold">@String.Format("{0:0,0}", item.SanPham.Gia) đ</td>
                    <td>
                        <form action="@Url.Action("UpdateQuantity", "Cart")" method="post" class="d-flex">
                            <input type="hidden" name="id" value="@item.SanPham.MaSanPham" />
                            <input type="number" name="quantity" value="@item.SoLuong" class="form-control form-control-sm me-2" min="1" max="@item.SanPham.SoLuong" />
                            <button type="submit" class="btn btn-sm btn-success">Cập nhật</button>
                        </form>
                    </td>
                    <td>@String.Format("{0:0,0}", item.ThanhTien) đ</td>
                    <td>
                        <a href="@Url.Action("RemoveItem", "Cart", new { id = item.SanPham.MaSanPham })" class="btn btn-sm btn-danger">Xóa</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="row mt-4">
        <div class="col-md-5 mb-3">
            <div class="card p-3 shadow-sm border-0 bg-light">
                <form action="@Url.Action("ApplyPromo", "Cart")" method="post">
                    <label class="form-label fw-bold">🎫 Nhập mã giảm giá (Nếu có):</label>
                    <div class="input-group">
                        <input type="text" name="promoCode" class="form-control" placeholder="Ví dụ: SALE10, TGDD20" value="@Session["PromoCode"]" />
                        <button type="submit" class="btn btn-dark fw-bold">Áp dụng</button>
                    </div>
                </form>
            </div>
        </div>

        <div class="col-md-6 offset-md-1 text-end">
            <p class="mb-1 text-muted">Tạm tính: <span>@String.Format("{0:0,0}", ViewBag.TongTienGoc) đ</span></p>
            <p class="mb-1 text-muted">Giảm giá (@ViewBag.PhanTramGiam%): <span class="text-success">-@String.Format("{0:0,0}", ViewBag.SoTienGiam) đ</span></p>
            <h3 class="text-danger fw-bold mt-2">Tổng tiền thanh toán: @String.Format("{0:0,0}", ViewBag.TongTienSauGiam) VNĐ</h3>

            <form action="@Url.Action("Checkout", "Cart")" method="post" class="mt-3">
                <a href="@Url.Action("Index", "Product")" class="btn btn-secondary">Tiếp tục mua hàng</a>
                <button type="submit" class="btn btn-primary btn-lg ms-2 fw-bold">Xác nhận đặt hàng</button>
            </form>
        </div>
    </div>
}