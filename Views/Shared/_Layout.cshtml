<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Thế Giới Di Động</title>
    <link href="~/Content\bootstrap\css\bootstrap.min.css" rel="stylesheet" />
    <style>
        body {
            padding-top: 70px;
        }
        /* Đẩy nội dung xuống dưới Navbar cố định */
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark fixed-top">
        <div class="container">
            <a class="navbar-brand" href="@Url.Action("Index", "Product")">TheGioiDiDong</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index", "Product")">Trang chủ</a>
                    </li>

                    @if (Session["QuyenHan"] != null && Session["QuyenHan"].ToString() == "Admin")
                    {
                        <li class="nav-item">
                            <a class="nav-link text-warning fw-bold" href="@Url.Action("Index", "AdminHome")">
                                ⚙️ Về trang Quản Trị
                            </a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link text-warning" href="@Url.Action("Index", "Cart")">
                                🛒 Giỏ hàng
                            </a>
                        </li>
                    }

                    @if (Session["TenDangNhap"] != null)
                    {
                        <li class="nav-item">
                            <span class="nav-link text-success fw-bold">Chào, @Session["HoTen"]</span>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Logout", "Account")">Đăng xuất</a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Login", "Account")">Đăng nhập</a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <div class="container body-content mb-5">
        @RenderBody()
    </div>

   

    <script src="~/Content\bootstrap\js\jquery-3.3.1.min.js"></script>
    <script src="~/Content\bootstrap\js\bootstrap.bundle.min.js"></script>
    @RenderSection("scripts", required: false)
</body>
</html>