<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Quản Trị Hệ Thống</title>
    @*<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">*@
    <link href="~/Content\bootstrap\css\bootstrap.min.css" rel="stylesheet" />
    <style>
        body {
            background-color: #f4f6f9;
        }

        .admin-sidebar {
            min-height: 100vh;
            background-color: #212529;
            color: white;
        }

            .admin-sidebar .nav-link {
                color: #c2c7d0;
                padding: 12px 20px;
                border-radius: 4px;
                margin: 4px 10px;
            }

                .admin-sidebar .nav-link:hover {
                    background-color: rgba(255,255,255,0.1);
                    color: white;
                }

                .admin-sidebar .nav-link.active {
                    background-color: #0d6efd;
                    color: white;
                    fw-bold;
                }
    </style>
</head>
<body>
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-3 col-lg-2 px-0 admin-sidebar d-flex flex-column justify-content-between">
                <div>
                    <div class="p-3 text-center border-bottom border-secondary">
                        <h5 class="mb-0 text-warning fw-bold">TGDD Admin</h5>
                        <small class="text-muted">Chủ cửa hàng: @Session["HoTen"]</small>
                    </div>

                    <ul class="nav flex-column mt-3">
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"].ToString() == "AdminHome" ? "active" : "")"
                               href="@Url.Action("Index", "AdminHome")">
                                📊 Tổng quan thống kê
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"].ToString() == "AdminProduct" ? "active" : "")"
                               href="@Url.Action("Index", "AdminProduct")">
                                📱 Quản lý sản phẩm
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"].ToString() == "AdminKhuyenMai" ? "active" : "")"
                               href="@Url.Action("Index", "AdminKhuyenMai")">
                                🎫 Quản lý khuyến mãi
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"].ToString() == "AdminAccount" ? "active" : "")"
                               href="@Url.Action("Index", "AdminAccount")">
                                👥 Quản lý tài khoản
                            </a>
                        </li>
                    </ul>
                </div>

                <div class="p-3 border-top border-secondary">
                    <a href="@Url.Action("Index", "Product")" class="btn btn-outline-info btn-sm w-100 mb-2">🌐 Xem mặt tiền Shop</a>
                    <a href="@Url.Action("Logout", "Account")" class="btn btn-danger btn-sm w-100">🚪 Đăng xuất</a>
                </div>
            </div>

            <div class="col-md-9 col-lg-10 col-12 py-4 px-4">
                @RenderBody()
            </div>
        </div>
    </div>

    <script src="~/Scripts/jquery-3.3.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("scripts", required: false)
</body>
</html>