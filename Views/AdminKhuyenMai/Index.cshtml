@model IEnumerable<TheGioiDiDong.Models.KhuyenMai>
@{
    ViewBag.Title = "Quản lý mã khuyến mãi";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">🎫 Quản Lý Chương Trình Khuyến Mãi</h2>
        <a href="@Url.Action("Create", "AdminKhuyenMai")" class="btn btn-success fw-bold shadow-sm">
            ➕ Tạo Mã Giảm Giá Mới
        </a>
    </div>

    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr class="text-center">
                            <th>Mã Giảm Giá</th>
                            <th>Mức Giảm (%)</th>
                            <th>Ngày Bắt Đầu</th>
                            <th>Ngày Kết Thúc</th>
                            <th>Áp Dụng Cho Sản Phẩm</th>
                            <th>Thao Tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="text-center fw-bold text-primary">@item.MaGiamGia</td>
                                <td class="text-center fw-bold text-danger">@item.PhanTramGiam%</td>
                                <td class="text-center">@(item.NgayBatDau.HasValue ? item.NgayBatDau.Value.ToString("dd/MM/yyyy") : "Không giới hạn")</td>
                                <td class="text-center">@(item.NgayKetThuc.HasValue ? item.NgayKetThuc.Value.ToString("dd/MM/yyyy") : "Không giới hạn")</td>
                                <td>@(item.SanPham != null ? item.SanPham.TenSanPham : "Tất cả sản phẩm")</td>
                                <td class="text-center">
                                    <a href="@Url.Action("Delete", "AdminKhuyenMai", new { id = item.MaKM })" class="btn btn-sm btn-outline-danger" onclick="return confirm('Bạn có thực sự muốn hủy chương trình khuyến mãi này?');">🗑️ Hủy mã</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>