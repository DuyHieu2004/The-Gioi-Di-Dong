@model TheGioiDiDong.Models.SanPham
@{
    ViewBag.Title = "Chi tiết sản phẩm - " + Model.TenSanPham;
    Layout = "~/Views/Shared/_Layout.cshtml";
    var danhSachBinhLuan = ViewBag.BinhLuan as List<TheGioiDiDong.Models.BinhLuan>;
}

<div class="container mt-5 mb-5">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Product")" class="text-decoration-none">Trang chủ</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.TenSanPham</li>
        </ol>
    </nav>

    <div class="card shadow-sm border-0 p-4 bg-white" style="border-radius: 16px;">
        <div class="row">
            <div class="col-md-6 d-flex align-items-center justify-content-center border-end border-light mb-4 mb-md-0">
                <div class="p-3" style="max-height: 450px; width: 100%;">
                    <img src="~/Content/Images/@Model.HinhAnh" class="img-fluid d-block mx-auto" alt="@Model.TenSanPham" style="max-height: 400px; object-fit: contain;">
                </div>
            </div>

            <div class="col-md-6 ps-md-5 d-flex flex-column justify-content-between">
                <div>
                    <h2 class="fw-bold text-dark mb-2">@Model.TenSanPham</h2>

                    <div class="mb-3 d-flex align-items-center">
                        <span class="badge bg-warning text-dark me-2 fs-6">⭐ @ViewBag.DanhGiaTtrungBinh.ToString("0.0") / 5.0</span>
                        <small class="text-muted">(Dựa trên lượt đánh giá từ khách hàng)</small>
                    </div>

                    <hr class="text-muted">

                    <div class="mb-4">
                        <span class="text-muted d-block mb-1">Giá bán chính thức:</span>
                        <span class="text-danger fw-bolder fs-2">@String.Format("{0:0,0}", Model.Gia) ₫</span>
                    </div>

                    <div class="mb-4">
                        <span class="fw-bold">Tình trạng:</span>
                        @if (Model.SoLuong > 0)
                        {
                            <span class="badge bg-success ms-2">Còn hàng (@Model.SoLuong sản phẩm)</span>
                        }
                        else
                        {
                            <span class="badge bg-danger ms-2">Hết hàng tạm thời</span>
                        }
                    </div>

                    <div class="mb-4 bg-light p-3" style="border-radius: 8px;">
                        <h6 class="fw-bold text-secondary mb-2">Đặc điểm nổi bật:</h6>
                        <p class="text-dark mb-0" style="line-height: 1.6;">@Model.MoTa</p>
                    </div>
                </div>

                <div class="d-grid gap-2 mt-4">
                    @if (Session["QuyenHan"] != null && Session["QuyenHan"].ToString() == "Admin")
                    {
                        <button class="btn btn-dark btn-lg py-3 fw-bold" disabled>
                            🔒 QUẢN TRỊ VIÊN KHÔNG THỂ MUA HÀNG
                        </button>
                    }
                    else if (Model.SoLuong > 0)
                    {
                        <a href="@Url.Action("AddToCart", "Cart", new { id = Model.MaSanPham })" class="btn btn-warning btn-lg fw-bold text-dark shadow-sm py-3">
                            🛒 THÊM VÀO GIỎ HÀNG NGAY
                        </a>
                    }
                    else
                    {
                        <button class="btn btn-secondary btn-lg py-3 fw-bold" disabled>
                            ❌ SẢN PHẨM HIỆN ĐANG HẾT HÀNG
                        </button>
                    }

                    <a href="@Url.Action("Index", "Product")" class="btn btn-outline-secondary py-2 mt-2">
                        ← Quay lại danh sách sản phẩm
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0 p-4 bg-white mt-5" style="border-radius: 16px;">
        <h4 class="fw-bold text-dark mb-4">💬 Bình luận từ người dùng</h4>

        @if (danhSachBinhLuan != null && danhSachBinhLuan.Any())
        {
            <div class="list-group list-group-flush">
                @foreach (var bl in danhSachBinhLuan)
                {
                    <div class="list-group-item px-0 py-3 border-bottom border-light">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <strong class="text-primary fs-6">@(bl.NguoiDung?.HoTen ?? "Khách hàng ẩn danh")</strong>
                            <small class="text-muted">🕒 @(bl.NgayBinhLuan.HasValue ? bl.NgayBinhLuan.Value.ToString("dd/MM/yyyy HH:mm") : "")</small>
                        </div>
                        <p class="text-dark mb-0" style="font-size: 15px; padding-left: 5px;">@bl.NoiDung</p>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="alert alert-light text-center py-4 my-2" role="alert" style="border: 1px dashed #dee2e6;">
                Chưa có bình luận nào cho sản phẩm này. Hãy là người đầu tiên để lại ý kiến!
            </div>
        }
    </div>

    <div class="bg-light p-4 mb-4 rounded-3">
        <h5 class="fw-bold text-dark mb-3">✍️ Gửi ý kiến của bạn</h5>

        @if (Session["MaNguoiDung"] != null)
        {
            using (Html.BeginForm("SubmitReview", "Product", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="maSanPham" value="@Model.MaSanPham" />

                <div class="mb-3">
                    <label class="form-label fw-bold d-block">Đánh giá của bạn về sản phẩm này:</label>
                    <div class="btn-group" role="group" aria-label="Rating">
                        @for (int i = 1; i <= 5; i++)
                        {
                            <input type="radio" class="btn-check" name="soSao" id="star@i" value="@i" @(i == 5 ? "checked" : "")>
                            <label class="btn btn-outline-warning" for="star@i">@i ⭐</label>
                        }
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Nội dung thảo luận:</label>
                    <textarea name="noiDung" class="form-control" rows="3" placeholder="Mời bạn chia sẻ cảm nhận về sản phẩm... (chất lượng, pin, camera, thiết kế)" required></textarea>
                </div>

                <button type="submit" class="btn btn-primary fw-bold px-4">Gửi bình luận</button>
            }
        }
        else
        {
            <div class="text-center py-2">
                <p class="mb-2 text-muted">Vui lòng đăng nhập tài khoản để có thể tham gia bình luận và đánh giá sản phẩm.</p>
                <a href="@Url.Action("Login", "Account")" class="btn btn-sm btn-outline-primary fw-bold">Đăng nhập ngay</a>
            </div>
        }
    </div>
</div>